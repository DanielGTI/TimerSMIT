{
  "manifestVersion": 1,
  "id": "timersmit-timetracker-dev",
  "publisher": "TrackerSMIT",
  "version": "0.17.0",
  "name": "Controle de horas (dev)",
  "description": "Extensão de desenvolvimento — registro e aprovação de horas integrados ao Azure DevOps.",
  "public": false,
  "categories": ["Azure Boards"],
  "targets": [{ "id": "Microsoft.VisualStudio.Services" }],
  "icons": {
    "default": "marketplace/icon.png"
  },
  "scopes": ["vso.work", "vso.memberentitlementmanagement"],
  "contributions": [
    {
      "id": "work-item-guide",
      "type": "ms.vss-work-web.work-item-form-page",
      "targets": ["ms.vss-work-web.work-item-form"],
      "properties": {
        "name": "Controle de horas",
        "uri": "dist/src/pages/work-item/index.html"
      }
    },
    {
      "id": "hub-group",
      "type": "ms.vss-web.hub-group",
      "targets": ["ms.vss-web.project-hub-groups-collection"],
      "properties": {
        "name": "Controle de horas",
        "order": 100
      }
    },
    {
      "id": "instructions-hub",
      "type": "ms.vss-web.hub",
      "targets": ["TrackerSMIT.timersmit-timetracker-dev.hub-group"],
      "properties": {
        "name": "Instruções",
        "uri": "dist/src/pages/instructions/index.html",
        "order": 5,
        "icon": {
          "light": "asset://marketplace/nav/instrucoes-light.png",
          "dark": "asset://marketplace/nav/instrucoes-dark.png"
        }
      }
    },
    {
      "id": "timesheet-hub",
      "type": "ms.vss-web.hub",
      "targets": ["TrackerSMIT.timersmit-timetracker-dev.hub-group"],
      "properties": {
        "name": "Folha semanal",
        "uri": "dist/src/pages/timesheet/index.html",
        "order": 10,
        "icon": {
          "light": "asset://marketplace/nav/folha-semanal-light.png",
          "dark": "asset://marketplace/nav/folha-semanal-dark.png"
        }
      }
    },
    {
      "id": "approvals-hub",
      "type": "ms.vss-web.hub",
      "targets": ["TrackerSMIT.timersmit-timetracker-dev.hub-group"],
      "properties": {
        "name": "Aprovações",
        "uri": "dist/src/pages/approvals/index.html",
        "order": 20,
        "icon": {
          "light": "asset://marketplace/nav/aprovacoes-light.png",
          "dark": "asset://marketplace/nav/aprovacoes-dark.png"
        }
      }
    },
    {
      "id": "reports-hub",
      "type": "ms.vss-web.hub",
      "targets": ["TrackerSMIT.timersmit-timetracker-dev.hub-group"],
      "properties": {
        "name": "Relatórios",
        "uri": "dist/src/pages/reports/index.html",
        "order": 30,
        "icon": {
          "light": "asset://marketplace/nav/relatorios-light.png",
          "dark": "asset://marketplace/nav/relatorios-dark.png"
        }
      }
    },
    {
      "id": "settings-hub",
      "type": "ms.vss-web.hub",
      "targets": ["TrackerSMIT.timersmit-timetracker-dev.hub-group"],
      "properties": {
        "name": "Configuração",
        "uri": "dist/src/pages/settings/index.html",
        "order": 40,
        "icon": {
          "light": "asset://marketplace/nav/configuracao-light.png",
          "dark": "asset://marketplace/nav/configuracao-dark.png"
        }
      }
    }
  ],
  "files": [
    { "path": "dist", "addressable": true },
    { "path": "marketplace/icon.png", "addressable": true },
    { "path": "marketplace/nav", "addressable": true }
  ]
}
